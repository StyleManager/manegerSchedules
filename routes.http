@baseUrl = http://localhost:3333

###
GET {{baseUrl}}/health

###
# Create User
POST {{baseUrl}}/cadastrar
Content-Type: application/json

{
    "name": "joseph",
    "email": "opa@gamil.com",
    "senha": "zezinho"
}

###
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "opa@gamil.com",
    "senha": "zezinho"
}

###
@token = {{login.response.body.acessToken}}


###
# @name Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}

###
# @name Auth
GET {{baseUrl}}/auth
Authorization: Bearer {{token}}

#List Schedules
###
GET {{baseUrl}}/schedules/free
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/schedules/free/day/12:00
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/schedules/free/hour/2026-04-01
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/schedules/hairDresser/hour/2026-04-01/1
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/schedules/hairDresser/day/12:00/2
Authorization: Bearer {{token}}

#List Services
###
GET {{baseUrl}}/schedules/type
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/schedules/hairDresser
Authorization: Bearer {{token}}

#Create Schedule
###
POST {{baseUrl}}/schedule
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "destinary_name": "joseph",
    "destinary_email": "opa@gamil.com",
    "dayHorarioId": "bd4d19f7-71ae-44b9-aa9d-0fa93f06918a",
    "tipoServicoId": "1",
    "cabeleleiroId": "1"
}